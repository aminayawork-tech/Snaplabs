# Set this to your Render backend URL in production
NEXT_PUBLIC_API_URL=http://localhost:8000

# Social listening — live data sources
# Reddit via RapidAPI ("Reddit" by SteadyAPI) — used when REDDIT_CLIENT_ID is not set
RAPIDAPI_KEY=
RAPIDAPI_REDDIT_HOST=reddit3.p.rapidapi.com
# TikTok via RapidAPI ("TikTok Scraper") — same RAPIDAPI_KEY
RAPIDAPI_TIKTOK_HOST=tiktok-scraper7.p.rapidapi.com
RAPIDAPI_FACEBOOK_HOST=facebook-scraper3.p.rapidapi.com
RAPIDAPI_TWITTER_HOST=twitter-api45.p.rapidapi.com
# Reddit official API: create a free "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# YouTube Data API v3 key (videos + comments)
YOUTUBE_API_KEY=

# Blog publishing (GitHub → Vercel)
# Fine-grained token with Contents + Pull requests read/write on your website repo
GITHUB_TOKEN=
GITHUB_REPO=yourname/your-site
GITHUB_BLOG_DIR=content/blog
GITHUB_BLOG_EXT=md
# Optional — defaults to the repo's default branch
GITHUB_BRANCH=

# Mailchimp (creates draft campaigns, never sends)
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
# Optional — defaults to the audience's campaign defaults
MAILCHIMP_FROM_NAME=
MAILCHIMP_REPLY_TO=

# Saved research sync across browsers (Vercel → Storage → Upstash for Redis sets these automatically)
KV_REST_API_URL=
KV_REST_API_TOKEN=
